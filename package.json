{
  "name": "nyx-fission",
  "version": "1.1.1",
  "type": "module",
  "main": "./dist/nyx-fission.js",
  "module": "./dist/nyx-fission.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nyx-fission.js",
      "default": "./dist/nyx-fission.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "declarations": "tsc -p tsconfig.types.json",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "vitest",
    "lint": "eslint .",
    "dev": "vite --config vite.config.ts --mode demo",
    "build:demo": "vite build --config vite.config.ts --mode demo",
    "test:demo": "pnpm build:demo && node demo/smoke.mjs",
    "prepack": "run-s build declarations",
    "format:demo": "prettier --write demo/App.vue demo/style.scss",
    "format:demo:check": "prettier --check demo/App.vue demo/style.scss"
  },
  "peerDependencies": {
    "three": ">=0.171.0 <1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.14.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^7.0.2",
    "nyx-kit": "^2.0.40",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "three": "^0.171.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-glsl": "^1.3.1",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
